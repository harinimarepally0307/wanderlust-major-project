<% layout("/layouts/boilerplate") %>
<br>
<br>
<br>
<div class="row mt-3">
    <div class="col-8 offset-2">

    
        <h3>Create a new Listing</h3>
        <form method="post" action="/listings" novalidate class="needs-validation">
            <div class="mb-3">
                <label for="title" class="form-label">Title</label>
                <input name="listing[title]" placeholder="enter title" type="text" class="form-control" required />
                <div class="valid-feedback">Title looks good!!</div>
                <div class="invalid-feedback">please enter a valid title!!</div>
                
            </div>

            <div class="mb-3">
                <label for="description" class="form-label">Description</label>
                <textarea name="listing[description]" class="form-control" required></textarea>
                 <div class="valid-feedback">description looks good!!</div>
                <div class="invalid-feedback">please enter a valid description!!</div>
            </div>

            <div class="mb-3">
                <label for="image" class="form-label">Image Link</label>
                <input name="listing[image][url]" placeholder="enter image URL/Link" type="text" class="form-control" required  />
                 <div class="valid-feedback">img url is in correct format!!</div>
                   <div class="invalid-feedback">please enter a img from unsplash!!</div>
            </div>


           
            <div class="mb-3">
                <label for="price" class="form-label">Price</label>
                <input name="listing[price]" placeholder="enter price"  class="form-control" required />
                <div class="valid-feedback">Price is valid!!</div>
                <div class="invalid-feedback">please enter a valid price!!</div>
                 
            </div>
             <div class="row">
                <div class="mb-3 col-4">
                <label for="country" class="form-label">Country</label>
                <input name="listing[country]" placeholder="enter country" type="text" class="form-control" required/>
                <div class="valid-feedback"> valid country name!!</div>
                <div class="invalid-feedback">please enter a valid country!!</div>
            </div>

            <div class="mb-3 col-8">
                <label for="location" class="form-label">Location</label>
                <input name="listing[location]" placeholder="enter location" type="text" class="form-control" required/>
                <div class="valid-feedback">Location is valid!!</div>
                <div class="invalid-feedback">please enter a valid Location!!</div>

            </div>
            </div>
            
            <br>
            
            <button type="submit" class="btn btn-dark add-btn mt-3">Add</button>
        </form>
        </div>
        </div>
        <br>
        <br>
        <br>
